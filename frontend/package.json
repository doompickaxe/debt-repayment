{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:api": "node -e \"require('fs').rmSync('src/app/api',{recursive:true,force:true})\" && openapi-generator-cli generate --generator-key api",
    "start": "yarn generate:api && ng serve",
    "build": "yarn generate:api && ng build",
    "watch": "yarn generate:api && ng build --watch --configuration development",
    "test": "yarn generate:api && ng test"
  },
  "private": true,
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@spartan-ng/brain": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "postcss": "^8.5.28",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@spartan-ng/cli": "^1.5.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
